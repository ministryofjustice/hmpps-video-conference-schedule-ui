{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}

{% set hideBackLink = true %}
{% set pageTitle = "Video link availability checker: " + prison.name %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <form method='POST'>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-quarter">
                        {{ mojDatePicker({
                            id: 'date',
                            name: 'date',
                            label: {
                                text: "Date",
                                classes: 'govuk-label--s'
                            },
                            hint: {
                                text: 'For example, ' + now() | formatDate('dd/MM/yyyy')
                            },
                            errorMessage: validationErrors | findError('date'),
                            value: formResponses.date or date | formatDate('dd/MM/yyyy') or now() | formatDate('dd/MM/yyyy')
                        }) }}
                    </div>
                    <div class="govuk-grid-column-one-quarter">
                        {{ govukRadios({
                            idPrefix: "period",
                            name: "period",
                            fieldset: {
                                legend: {
                                    text: "Session",
                                    classes: "govuk-fieldset__legend--s govuk-!-margin-bottom-7"
                                }
                            },
                            items: [
                                {
                                    value: "AM",
                                    text: "Morning",
                                    checked: formResponses.period == "AM" or period == "AM"
                                },
                                {
                                    value: "PM",
                                    text: "Afternoon",
                                    checked: formResponses.period == "PM" or period == "PM"
                                },
                                {
                                    value: "ED",
                                    text: "Evening",
                                    checked: formResponses.period == "ED" or period == "ED"
                                }
                            ],
                            errorMessage: validationErrors | findError("duration"),
                            classes: "govuk-!-width-one-third"
                        }) }}
                    </div>
                </div>
                <div>
                    {{ govukButton({
                        html: "Update",
                        preventDoubleClick: true,
                        type: "submit"
                    }) }}
                    <p class="govuk-body-m">Last updated {{ now() | formatDate('HH:mm') }}</p>
                </div>
            </form>
        </div>
    </div>
    <div class="govuk-grid-row govuk-!-margin-top-3">
        <div class="govuk-grid-column-full">
            {% set rows = [] %}
            {{ roomsAvailabilityRows(period, roomAvailability, rows) }}

            {% if period == "AM" %}
                {{ govukTable({
                    caption: "Date and time availability",
                    captionClasses: "govuk-table__caption--m",
                    firstCellIsHeader: true,
                    head: [
                        {
                            text: "Rooms"
                        },
                        {
                            text: "08:00",
                            attributes: {
                                "data-qa": "time-8"
                            }
                        },
                        {
                            text: "09:00"
                        },
                        {
                            text: "10:00"
                        },
                        {
                            text: "11:00"
                        },
                        {
                            text: "12:00"
                        }
                    ],
                    rows: rows
                }) }}
            {% endif %}
            {% if period == "PM" %}
                {{ govukTable({
                    caption: "Date and time availability",
                    captionClasses: "govuk-table__caption--m",
                    firstCellIsHeader: true,
                    head: [
                        {
                            text: "Rooms"
                        },
                        {
                            text: "13:00",
                            attributes: {
                                "data-qa": "time-13"
                            }
                        },
                        {
                            text: "14:00"
                        },
                        {
                            text: "15:00"
                        },
                        {
                            text: "16:00"
                        },
                        {
                            text: "17:00"
                        }
                    ],
                    rows: rows
                }) }}
            {% endif %}
            {% if period == "ED" %}
                {{ govukTable({
                    caption: "Date and time availability",
                    captionClasses: "govuk-table__caption--m",
                    firstCellIsHeader: true,
                    head: [
                        {
                            text: "Rooms"
                        },
                        {
                            text: "18:00",
                            attributes: {
                                "data-qa": "time-18"
                            }
                        },
                        {
                            text: "19:00"
                        },
                        {
                            text: "20:00"
                        }
                    ],
                    rows: rows
                }) }}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% macro roomsAvailabilityRows(period, roomAvailability, rows) %}
    {% for room in roomAvailability %}
        {% if period == "ED" %}
            {% set rows = (rows.push(
                [
                    {
                        text: room.description
                    },
                    {
                        html: roomHtml(room, 0),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[0].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 1),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[1].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 2),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[2].fullyBooked else ''
                    }
                ]
            ), rows) %}
        {% else %}
            {% set rows = (rows.push(
                [
                    {
                        text: room.description
                    },
                    {
                        html: roomHtml(room, 0),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[0].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 1),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[1].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 2),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[2].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 3),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[3].fullyBooked else ''
                    },
                    {
                        html: roomHtml(room, 4),
                        classes: 'govuk-table__cell--booked' if room.hourlySlots[4].fullyBooked else ''
                    }
                ]
            ), rows) %}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro roomHtml(room, index) %}
    {% if room.hourlySlots[index].fullyBooked %}
    <div>Booked</div>
    {% else %}
      {% if room.hourlySlots[index].free.length %}
          <ul class="govuk-list govuk-list__orange govuk-list--spaced">
              {% for startEnd in room.hourlySlots[index].free %}
                  <li>Free {{ startEnd.startTime }} - {{ startEnd.endTime }}</li>
              {% endfor %}
          </ul>
      {% else %}
          <ul class="govuk-list govuk-list__green">
              <li>Free</li>
          </ul>
      {% endif %}
    {% endif %}
{% endmacro %}
