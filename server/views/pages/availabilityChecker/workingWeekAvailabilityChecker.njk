{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "partials/availability.njk" import availability %}

{% set hideBackLink = true %}
{% set pageTitle = "Video link availability checker: " + prison.name %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <form method='POST'>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-quarter">
                        {{ mojDatePicker({
                            id: 'date',
                            name: 'date',
                            label: {
                                text: "Date",
                                classes: 'govuk-label--s'
                            },
                            hint: {
                                text: 'For example, ' + now() | formatDate('dd/MM/yyyy')
                            },
                            excludedDays: "saturday sunday",
                            errorMessage: validationErrors | findError('date'),
                            value: formResponses.date or date | formatDate('dd/MM/yyyy') or now() | formatDate('dd/MM/yyyy')
                        }) }}
                    </div>
                    <div class="govuk-grid-column-one-quarter">
                        {{ govukRadios({
                            idPrefix: "period",
                            name: "period",
                            fieldset: {
                                legend: {
                                    text: "Session",
                                    classes: "govuk-fieldset__legend--s govuk-!-margin-bottom-7"
                                }
                            },
                            items: [
                                {
                                    value: "AM",
                                    text: "Morning",
                                    checked: formResponses.period == "AM" or period == "AM"
                                },
                                {
                                    value: "PM",
                                    text: "Afternoon",
                                    checked: formResponses.period == "PM" or period == "PM"
                                },
                                {
                                    value: "ED",
                                    text: "Evening",
                                    checked: formResponses.period == "ED" or period == "ED"
                                }
                            ],
                            errorMessage: validationErrors | findError("duration"),
                            classes: "govuk-!-width-one-third"
                        }) }}
                    </div>
                    <div class="appointments-link-div">
                        <a data-qa="appointments-link" class="govuk-link govuk-link--no-visited-state" href="{{ appointmentsLink }}" rel="noreferrer noopener" target="_blank">Book an appointment in a new tab</a>
                    </div>
                </div>
                <div>
                    {{ govukButton({
                        html: "Update",
                        preventDoubleClick: true,
                        type: "submit"
                    }) }}
                </div>
            </form>
        </div>
    </div>
    <div class="govuk-grid-row govuk-!-margin-top-3">
        <div class="govuk-grid-column-full">
            <div class="govuk-heading-s">Date and time availability</div>
            <p class="govuk-body-m">Last updated {{ now() | formatDate('HH:mm') }}</p>
            <div>
                {{ govukTabs({
                    items: [
                        {
                            label: monday | formatDate('iii d MMM'),
                            id: "monday",
                            panel: {
                            html: availability(period, mondayAvailability)
                        }
                        },
                        {
                            label: tuesday | formatDate('iii d MMM'),
                            id: "tuesday",
                            panel: {
                            html: availability(period, tuesdayAvailability)
                        }
                        },
                        {
                            label: wednesday | formatDate('iii d MMM'),
                            id: "wednesday",
                            panel: {
                            html: availability(period, wednesdayAvailability)
                        }
                        },
                        {
                            label: thursday | formatDate('iii d MMM'),
                            id: "thursday",
                            panel: {
                            html: availability(period, thursdayAvailability)
                        }
                        },
                        {
                            label: friday | formatDate('iii d MMM'),
                            id: "friday",
                            panel: {
                            html: availability(period, fridayAvailability)
                        }
                        }
                    ]
                }) }}
            </div>
            <div class="govuk-pagination__prev">
                <a class="govuk-link govuk-pagination__link" href="/availability-checker?date={{ previousWeek | formatDate('yyyy-MM-dd') }}&period={{ period }}" rel="prev">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">Previous week</span>
                </a>
            </div>
            <div class="govuk-pagination__next">
                <a class="govuk-link govuk-pagination__link" href="/availability-checker?date={{ nextWeek | formatDate('yyyy-MM-dd') }}&period={{ period }}" rel="next">
                    <span class="govuk-pagination__link-title">Next week</span>
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
{% endblock %}
