{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}

{% set hideBackLink = true %}
{% set pageTitle = "Check video room availability: " + prison.name %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <form method='POST'>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-quarter">
                        {{ mojDatePicker({
                            id: 'date',
                            name: 'date',
                            label: {
                                text: "Date",
                                classes: 'govuk-label--s'
                            },
                            hint: {
                                text: 'For example, ' + now() | formatDate('dd/MM/yyyy')
                            },
                            excludedDays: "saturday sunday",
                            errorMessage: validationErrors | findError('date'),
                            value: formResponses.date or date | formatDate('dd/MM/yyyy') or now() | formatDate('dd/MM/yyyy')
                        }) }}
                    </div>
                    <div class="govuk-grid-column-one-quarter">
                        {{ govukRadios({
                            idPrefix: "period",
                            name: "period",
                            fieldset: {
                                legend: {
                                    text: "Session",
                                    classes: "govuk-fieldset__legend--s govuk-!-margin-bottom-7"
                                }
                            },
                            items: [
                                {
                                    value: "AM",
                                    text: "Morning",
                                    checked: formResponses.period == "AM" or period == "AM"
                                },
                                {
                                    value: "PM",
                                    text: "Afternoon",
                                    checked: formResponses.period == "PM" or period == "PM"
                                },
                                {
                                    value: "ED",
                                    text: "Evening",
                                    checked: formResponses.period == "ED" or period == "ED"
                                }
                            ],
                            errorMessage: validationErrors | findError("duration"),
                            classes: "govuk-!-width-one-third"
                        }) }}
                    </div>
                    <div class="appointments-link-div">
                        <a data-qa="appointments-link" class="govuk-link govuk-link--no-visited-state"
                           href="{{ appointmentsLink }}" rel="noreferrer noopener" target="_blank">Book an appointment
                            in a new tab</a>
                    </div>
                </div>
                <div>
                    {{ govukButton({
                        html: "Update",
                        preventDoubleClick: true,
                        type: "submit"
                    }) }}
                </div>
            </form>
        </div>
    </div>

    <div class="govuk-grid-row govuk-!-margin-top-3">
        <div class="govuk-grid-column-full">
            <div class="govuk-heading-s">Date and time availability</div>
            <p class="govuk-body-m">Last updated {{ now() | formatDate('HH:mm') }}</p>
        </div>
    </div>


    {# Entire block is the schedule container to display session data #}

    <div class="schedule-container">

        <!-- Timeline header labels -->
        <div class="schedule-row header">
            <div class="location-col">Location</div>
            <div class="timeline-col grid-header-timeline" data-total-hours="{{ sessionData.totalHours }}">
                {% for label in sessionData.hourLabels %}
                    {% if not loop.last %}
                        <div class="hour-label-container">
                            <div class="hour-label">{{ label }}</div>
                        </div>
                    {% endif %}
                {% endfor %}
                <div class="hour-label-container final-stamp">
                    <div class="hour-label">{{ sessionData.hourLabels | last }}</div>
                </div>
            </div>
        </div>

        <!-- Rows for Locations -->
        {% for row in sessionData.locations %}

            {# Browser compatibility - ensure 'px' is appended for CSS variable parsing if the raw object value is a plain number #}
            {% set rowHeight = row.totalRowHeight if 'px' in (row.totalRowHeight | string) else row.totalRowHeight ~ 'px' %}

            <div class="schedule-row" data-row-height="{{ rowHeight }}">

                {# Location name #}
                <div class="location-col"><strong>{{ row.localName }}</strong></div>

                <div class="timeline-col content-timeline">

                    <!-- Background hour lines -->
                    <div class="grid-background-lines" data-total-hours="{{ sessionData.totalHours }}">
                        {% for i in range(0, sessionData.totalHours | int) %}
                            <div class="hour-marker-line"></div>
                        {% endfor %}
                    </div>

                    <!-- Booked appointment cards -->
                    {% for event in row.events %}
                        {# Browser compatibility - ensure 'px' to track offsets to maintain absolute top container boundaries #}
                        {% set trackTop = event.trackOffset if 'px' in (event.trackOffset | string) else event.trackOffset ~ 'px' %}

                        {# Browser compatibility - ensire left/width values have explicit percentage signs appended if not present in data #}
                        {% set cardLeft = event.leftPct if '%' in (event.leftPct | string) else event.leftPct ~ '%' %}
                        {% set cardWidth = event.widthPct if '%' in (event.widthPct | string) else event.widthPct ~ '%' %}

                        <div class="appointment-card"
                             data-left="{{ cardLeft }}"
                             data-width="{{ cardWidth }}"
                             data-top="{{ trackTop }}"
                             title="{{ event.subTypeDescription }}">
                            <span class="app-title">{{ event.subTypeDescription }}</span>
                            <span class="app-time">{{ event.startTime }} - {{ event.endTime }}</span>
                        </div>
                    {% endfor %}

                    <!-- Thin availability indicator lines (Green) -->
                    {% for slot in row.freeSlots %}
                        {% set slotLeft = slot.leftPct if '%' in (slot.leftPct | string) else slot.leftPct ~ '%' %}
                        {% set slotWidth = slot.widthPct if '%' in (slot.widthPct | string) else slot.widthPct ~ '%' %}

                        <div class="free-space-line"
                             data-left="{{ slotLeft }}"
                             data-width="{{ slotWidth }}">
                            <span class="tooltip">Available: {{ slot.startTime }} - {{ slot.endTime }}</span>
                        </div>
                    {% endfor %}

                    <!-- Thin occupied indicator lines (Red) -->
                    {% for slot in row.bookedSlots %}
                        {% set slotLeft = slot.leftPct if '%' in (slot.leftPct | string) else slot.leftPct ~ '%' %}
                        {% set slotWidth = slot.widthPct if '%' in (slot.widthPct | string) else slot.widthPct ~ '%' %}

                        <div class="booked-space-line"
                             data-left="{{ slotLeft }}"
                             data-width="{{ slotWidth }}">
                            <span class="tooltip">Booked: {{ slot.startTime }} - {{ slot.endTime }}</span>
                        </div>
                    {% endfor %}

                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}
