{% extends "partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "partials/availability.njk" import availability %}
{% from "partials/printAvailability.njk" import printAvailability %}

{% set backLinkText = "Back to all appointments tasks" %}
{% set backLinkHref = (activitiesAndAppointmentsUrl + '/appointments') %}

{% set pageTitle = "Check video room availability: " + prison.name %}
{% set bodyClasses = "app-page-a4-landscape" %}

{% block content %}
    <div class="govuk-grid-row govuk-!-display-none-print">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
        </div>
    </div>
    <div class="govuk-grid-row govuk-!-display-none-print">
        <div class="govuk-grid-column-full">
            <form method='POST'>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-quarter">
                        {{ mojDatePicker({
                            id: 'date',
                            name: 'date',
                            label: {
                                text: "Date",
                                classes: 'govuk-label--s'
                            },
                            hint: {
                                text: 'For example, ' + now() | formatDate('dd/MM/yyyy')
                            },
                            excludedDays: "saturday sunday",
                            errorMessage: validationErrors | findError('date'),
                            value: formResponses.date or date | formatDate('dd/MM/yyyy') or now() | formatDate('dd/MM/yyyy')
                        }) }}
                    </div>
                    <div class="govuk-grid-column-one-half">
                        {{ govukRadios({
                            classes: "govuk-radios--inline",
                            idPrefix: "period",
                            name: "period",
                            fieldset: {
                                legend: {
                                    text: "Session",
                                    classes: "govuk-fieldset__legend--s govuk-!-margin-bottom-7"
                                }
                            },
                            items: [
                                {
                                    id: "period-am",
                                    value: "AM",
                                    text: "Morning",
                                    checked: formResponses.period == "AM" or period == "AM"
                                },
                                {
                                    id: "period-pm",
                                    value: "PM",
                                    text: "Afternoon",
                                    checked: formResponses.period == "PM" or period == "PM"
                                },
                                {
                                    id: "period-ed",
                                    value: "ED",
                                    text: "Evening",
                                    checked: formResponses.period == "ED" or period == "ED"
                                }
                            ],
                            errorMessage: validationErrors | findError("duration")
                        }) }}
                    </div>
                    <div class="appointments-link-div">
                        <a id="book-appointment-link" data-qa="appointments-link" class="govuk-link govuk-link--no-visited-state" href="{{ appointmentsLink }}" rel="noreferrer noopener" target="_blank">Book an appointment in a new tab</a>
                    </div>
                </div>
                <div>
                    {{ govukButton({
                        id: "update-availability",
                        html: "Update",
                        preventDoubleClick: true,
                        type: "submit"
                    }) }}
                </div>
            </form>
        </div>
    </div>
    <div class="govuk-grid-row govuk-!-margin-top-3">
        <div class="govuk-grid-column-full">
            <div class="govuk-heading-s govuk-!-display-none-print">Date and time availability</div>
            <p class="govuk-body-m govuk-!-display-none-print">Last updated {{ now() | formatDate('HH:mm') }}</p>
            {{ govukPagination({
                classes: 'govuk-!-display-none-print',
                previous: {
                    text: 'Previous week',
                    href: "/room-availability?date=" + previousWeek | formatDate('yyyy-MM-dd') + "&period=" + period,
                    attributes: {
                        "data-custom-id": "previous-week",
                        "data-qa": "previous-week"
                    }
                },
                next: {
                    text: 'Next week',
                    href: "/room-availability?date=" + nextWeek | formatDate('yyyy-MM-dd') + "&period=" + period,
                    attributes: {
                        "data-custom-id": "next-week",
                        "data-qa": "next-week"
                    }
                },
                items: [
                    {
                        number: 'Current week',
                        href: "/room-availability?date=" + currentWeekStartDate | formatDate('yyyy-MM-dd') + "&period=" + period,
                        attributes: {
                          "data-custom-id": "current-week",
                          "data-qa": "current-week"
                        }
                    } if currentWeekStartDate
                ]
            }) }}

            <div class="app-tabs-wrapper">

                {# The print link to display the full day availability - feature switched #}
                {% if printViewAvailability %}
                    <div class="app-tabs-action hmpps-action-bar govuk-!-display-none-print">
                        <div class="hmpps-print-and-export">
                            <button id="print-availability-link" class="hmpps-print-and-export--print">Print full day availability</button>
                        </div>
                    </div>
                {% endif %}

                {{ govukTabs({
                    classes: 'app-print-availability__tabs',
                    items: [
                        {
                            label: formattedDate(monday),
                            id: "monday",
                            panel: {
                                html: availability(period, mondayAvailability) + printAvailability(prison, monday, mondayPrintAvailability)
                            },
                            attributes: {
                                "data-qa": "monday_tab",
                                "data-custom-id": "monday-tab"
                            }
                        },
                        {
                            label: formattedDate(tuesday),
                            id: "tuesday",
                            panel: {
                                html: availability(period, tuesdayAvailability) + printAvailability(prison, tuesday, tuesdayPrintAvailability)
                            },
                            attributes: {
                                "data-qa": "tuesday_tab",
                                "data-custom-id": "tuesday-tab"
                            }
                        },
                        {
                            label: formattedDate(wednesday),
                            id: "wednesday",
                            panel: {
                                html: availability(period, wednesdayAvailability) + printAvailability(prison, wednesday, wednesdayPrintAvailability)
                            },
                            attributes: {
                                "data-qa": "wednesday_tab",
                                "data-custom-id": "wednesday-tab"
                            }
                        },
                        {
                            label: formattedDate(thursday),
                            id: "thursday",
                            panel: {
                                html: availability(period, thursdayAvailability) + printAvailability(prison, thursday, thursdayPrintAvailability)
                            },
                            attributes: {
                                "data-qa": "thursday_tab",
                                "data-custom-id": "thursday-tab"
                            }
                        },
                        {
                            label: formattedDate(friday),
                            id: "friday",
                            panel: {
                                html: availability(period, fridayAvailability) + printAvailability(prison, friday, fridayPrintAvailability)
                            },
                            attributes: {
                                "data-qa": "friday_tab",
                                "data-custom-id": "friday-tab"
                            }
                        }
                    ]
                }) }}
            </div>
        </div>
    </div>
{% endblock %}

{% macro formattedDate(date) %}
    {% if date | isYearBoundaryDate %}
        {{ date | formatDate('iii d MMM yyyy') }}
    {% else %}
        {{ date | formatDate('iii d MMM') }}
    {% endif %}
{% endmacro %}
