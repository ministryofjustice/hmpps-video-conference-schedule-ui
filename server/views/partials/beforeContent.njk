{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% if backLinkHref %}
  <nav>
    {{ govukBackLink({
      text: backLinkText or "Back",
      href: backLinkHref,
      classes: 'govuk-!-display-none-print',
      attributes: {
        rel: 'noreferrer'
      }
    }) }}
  </nav>
{% endif %}

